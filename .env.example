# Example env file — copy to .env and fill locally. NEVER commit real keys.
# Risk: .env is plaintext on disk; process environment is visible to other
# local users/tools. Prefer `forgeloop creds set` (OS keyring / encrypted file).

FORGELOOP_API_KEY=
FORGELOOP_API_BASE=https://api.openai.com/v1
FORGELOOP_MODEL=gpt-4o-mini
FORGELOOP_MASTER_PASSWORD=
FORGELOOP_USE_MOCK=1
